# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Connection string Postgres (Dashboard -> Connect -> URI, version "Session pooler")
# Sert uniquement à appliquer les migrations : npm run db:migrate
SUPABASE_DB_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

# Iron Session (minimum 32 chars, generate with: openssl rand -base64 32)
SESSION_SECRET=your-super-secret-key-minimum-32-characters

# Steam API (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=your-steam-api-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
